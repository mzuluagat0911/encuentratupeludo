# Ubica tu Peludo — variables de entorno
# Copia este archivo a .env.local y completa los valores.

# Supabase (requerido para producción / Vercel)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Sin estas variables, la app corre en "modo local"
# (datos en .data/reports.json y fotos en public/uploads/)
